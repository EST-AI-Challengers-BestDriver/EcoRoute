# Runtime publishes both regions' maps and compressed traffic profiles.
data/processed/traffic/*/edge_hourly_profiles.csv

# Keep the production DNN checkpoint; ignore any future intermediate checkpoints.
models/dnn/*
!models/dnn/best_model.pt

# Keep compact model reports, but exclude large row-level exports and runtime routes.
results/baseline/predictions.csv
results/baseline/split_assignments.csv
results/dnn/predictions.csv
results/route_energy/
results/routing/
results/traffic/

# Local verification code is not part of the frontend/backend handoff bundle.
tests/
